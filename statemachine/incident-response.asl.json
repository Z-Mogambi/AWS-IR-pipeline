{
  "Comment": "GuardDuty incident response. Verify the finding, establish the environment, apply the response policy, then notify or contain. Containment order is fixed by this file, not by the policy.",
  "StartAt": "VerifyFinding",
  "States": {
    "VerifyFinding": {
      "Type": "Task",
      "Comment": "Re-fetch the finding from GuardDuty. Everything downstream is derived from what this returns, never from the EventBridge payload.",
      "Resource": "${VerifyFunctionArn}",
      "ResultPath": "$.finding",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "NotifyVerifyFailed"
        }
      ],
      "Next": "EnrichInstance"
    },
    "EnrichInstance": {
      "Type": "Task",
      "Comment": "Best effort. On failure the Catch below substitutes a production-by-default result so the run still reaches a decision and a notification.",
      "Resource": "${EnrichFunctionArn}",
      "ResultPath": "$.enrichment",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.enrichmentError",
          "Next": "EnrichmentUnavailable"
        }
      ],
      "Next": "Decide"
    },
    "EnrichmentUnavailable": {
      "Type": "Pass",
      "Comment": "Enrichment failed outright. Fall back to production, which is the stricter of the two, and carry on to the decision.",
      "Result": {
        "environment": "production",
        "environmentSource": "default-enrichment-failed",
        "instance": null,
        "errors": [
          "The enrichment state failed; see $.enrichmentError."
        ]
      },
      "ResultPath": "$.enrichment",
      "Next": "Decide"
    },
    "Decide": {
      "Type": "Task",
      "Comment": "The only place a containment decision is made. Deliberately ahead of the Phase 6 AI triage.",
      "Resource": "${DecideFunctionArn}",
      "ResultPath": "$.decision",
      "TimeoutSeconds": 30,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "NotifyPipelineError"
        }
      ],
      "Next": "RouteDecision"
    },
    "RouteDecision": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.decision.decision",
          "StringEquals": "IGNORE",
          "Next": "RecordIgnored"
        },
        {
          "Variable": "$.decision.decision",
          "StringEquals": "AUTO_CONTAIN",
          "Next": "BeginContainment"
        },
        {
          "Variable": "$.decision.decision",
          "StringEquals": "APPROVAL_REQUIRED",
          "Next": "AwaitApproval"
        }
      ],
      "Default": "NotifyOnly"
    },
    "RecordIgnored": {
      "Type": "Pass",
      "Comment": "Below the notification threshold. The incident record still exists.",
      "End": true
    },
    "NotifyOnly": {
      "Type": "Task",
      "Resource": "${AlertFunctionArn}",
      "Parameters": {
        "notifyKind": "NOTIFY",
        "incidentId.$": "$.incidentId",
        "findingId.$": "$.findingId",
        "accountId.$": "$.accountId",
        "region.$": "$.region",
        "finding.$": "$.finding",
        "enrichment.$": "$.enrichment",
        "decision.$": "$.decision"
      },
      "ResultPath": "$.notification",
      "TimeoutSeconds": 30,
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "End": true
    },
    "AwaitApproval": {
      "Type": "Task",
      "Comment": "Pauses until a human calls SendTaskSuccess or SendTaskFailure. Both are IAM-authorised, so possession of the token is not consent.",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${AlertFunctionArn}",
        "Payload": {
          "notifyKind": "APPROVAL_REQUIRED",
          "taskToken.$": "$$.Task.Token",
          "executionArn.$": "$$.Execution.Id",
          "incidentId.$": "$.incidentId",
          "findingId.$": "$.findingId",
          "accountId.$": "$.accountId",
          "region.$": "$.region",
          "finding.$": "$.finding",
          "enrichment.$": "$.enrichment",
          "decision.$": "$.decision"
        }
      },
      "ResultPath": "$.approval",
      "TimeoutSecondsPath": "$.decision.approvalTimeoutSeconds",
      "Catch": [
        {
          "ErrorEquals": [
            "States.Timeout"
          ],
          "ResultPath": "$.error",
          "Next": "ApprovalTimedOut"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "NotifyApprovalDeclined"
        }
      ],
      "Next": "BeginContainment"
    },
    "ApprovalTimedOut": {
      "Type": "Choice",
      "Comment": "Nobody answering is not consent. In production the default is to escalate rather than contain.",
      "Choices": [
        {
          "Variable": "$.decision.approvalTimeoutAction",
          "StringEquals": "Contain",
          "Next": "BeginContainment"
        }
      ],
      "Default": "NotifyApprovalTimedOut"
    },
    "NotifyApprovalTimedOut": {
      "Type": "Task",
      "Resource": "${AlertFunctionArn}",
      "Parameters": {
        "notifyKind": "APPROVAL_TIMED_OUT",
        "incidentId.$": "$.incidentId",
        "findingId.$": "$.findingId",
        "accountId.$": "$.accountId",
        "region.$": "$.region",
        "finding.$": "$.finding",
        "enrichment.$": "$.enrichment",
        "decision.$": "$.decision"
      },
      "ResultPath": "$.notification",
      "TimeoutSeconds": 30,
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "ApprovalNotGranted"
    },
    "NotifyApprovalDeclined": {
      "Type": "Task",
      "Resource": "${AlertFunctionArn}",
      "Parameters": {
        "notifyKind": "APPROVAL_DENIED",
        "incidentId.$": "$.incidentId",
        "findingId.$": "$.findingId",
        "accountId.$": "$.accountId",
        "region.$": "$.region",
        "finding.$": "$.finding",
        "enrichment.$": "$.enrichment",
        "decision.$": "$.decision",
        "error.$": "$.error"
      },
      "ResultPath": "$.notification",
      "TimeoutSeconds": 30,
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "ApprovalNotGranted"
    },
    "ApprovalNotGranted": {
      "Type": "Fail",
      "Error": "ApprovalNotGranted",
      "Cause": "Containment was not approved, or nobody answered. Nothing was changed."
    },
    "BeginContainment": {
      "Type": "Pass",
      "Comment": "Seed the containment result so later ResultPaths have somewhere to write, and the notification states can reference it whichever steps ran.",
      "Result": {
        "instances": null
      },
      "ResultPath": "$.containment",
      "Next": "ContainInstances"
    },
    "ContainInstances": {
      "Type": "Map",
      "Comment": "One iteration per instance. An attack sequence names a group of them; a single-resource finding simply yields one iteration.",
      "ItemsPath": "$.enrichment.instances",
      "MaxConcurrencyPath": "$.decision.maxConcurrency",
      "Parameters": {
        "incidentId.$": "$.incidentId",
        "findingId.$": "$.findingId",
        "accountId.$": "$.accountId",
        "region.$": "$.region",
        "finding.$": "$.finding",
        "decision.$": "$.decision",
        "enrichment": {
          "instance.$": "$$.Map.Item.Value",
          "environment.$": "$.enrichment.environment"
        }
      },
      "Iterator": {
        "StartAt": "ShouldCollectEvidence",
        "States": {
          "ShouldCollectEvidence": {
            "Type": "Choice",
            "Comment": "Evidence comes first. An isolated instance cannot be reached by SSM, and an Auto Scaling group would replace it the moment it stops answering health checks.",
            "Choices": [
              {
                "Variable": "$.decision.doEvidence",
                "BooleanEquals": true,
                "Next": "CollectEvidence"
              }
            ],
            "Default": "ShouldIsolateNetwork"
          },
          "CollectEvidence": {
            "Type": "Task",
            "Resource": "${EvidenceFunctionArn}",
            "ResultPath": "$.containment.evidence",
            "TimeoutSeconds": 300,
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 3,
                "BackoffRate": 2
              }
            ],
            "Next": "ShouldIsolateNetwork"
          },
          "ShouldIsolateNetwork": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.decision.doNetwork",
                "BooleanEquals": true,
                "Next": "IsolateNetwork"
              }
            ],
            "Default": "ShouldContainCredentials"
          },
          "IsolateNetwork": {
            "Type": "Task",
            "Comment": "Per-incident quarantine group, opened wide so existing flows become untracked, applied to every ENI, then sealed. Phase 3 adds credential containment and disabling IMDS after this.",
            "Resource": "${NetIsolateFunctionArn}",
            "ResultPath": "$.containment.network",
            "TimeoutSeconds": 180,
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 3,
                "BackoffRate": 2
              }
            ],
            "Next": "ShouldContainCredentials"
          },
          "ShouldContainCredentials": {
            "Type": "Choice",
            "Comment": "Network isolation does nothing about credentials already stolen from the instance - the attacker is using them from their own machine.",
            "Choices": [
              {
                "Variable": "$.decision.doCredentials",
                "BooleanEquals": true,
                "Next": "ContainCredentials"
              }
            ],
            "Default": "ShouldDisableImds"
          },
          "ContainCredentials": {
            "Type": "Task",
            "Comment": "The only state that reaches the function holding iam:PutRolePolicy.",
            "Resource": "${CredContainFunctionArn}",
            "ResultPath": "$.containment.credentials",
            "TimeoutSeconds": 60,
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 3,
                "BackoffRate": 2
              }
            ],
            "Next": "ContainIdentity"
          },
          "ContainIdentity": {
            "Type": "Task",
            "Comment": "IAM user access keys only. The role paths are handled by the state above.",
            "Resource": "${IdentityFunctionArn}",
            "ResultPath": "$.containment.identity",
            "TimeoutSeconds": 60,
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 3,
                "BackoffRate": 2
              }
            ],
            "Next": "ShouldDisableImds"
          },
          "ShouldDisableImds": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.decision.doImds",
                "BooleanEquals": true,
                "Next": "DisableImds"
              }
            ],
            "Default": "InstanceContained"
          },
          "DisableImds": {
            "Type": "Task",
            "Comment": "Last, because it also cuts off the SSM agent. Nothing can be run on the instance remotely after this.",
            "Resource": "${ImdsFunctionArn}",
            "ResultPath": "$.containment.imds",
            "TimeoutSeconds": 60,
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 3,
                "BackoffRate": 2
              }
            ],
            "Next": "InstanceContained"
          },
          "InstanceContained": {
            "Type": "Pass",
            "Comment": "End of the per-instance chain. The Map collects one of these per instance.",
            "End": true
          }
        }
      },
      "ResultPath": "$.containment.instances",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "NotifyContainmentFailed"
        }
      ],
      "Next": "NotifyContained"
    },
    "NotifyContained": {
      "Type": "Task",
      "Resource": "${AlertFunctionArn}",
      "Parameters": {
        "notifyKind": "CONTAINED",
        "incidentId.$": "$.incidentId",
        "findingId.$": "$.findingId",
        "accountId.$": "$.accountId",
        "region.$": "$.region",
        "finding.$": "$.finding",
        "enrichment.$": "$.enrichment",
        "decision.$": "$.decision",
        "containment.$": "$.containment"
      },
      "ResultPath": "$.notification",
      "TimeoutSeconds": 30,
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "End": true
    },
    "NotifyContainmentFailed": {
      "Type": "Task",
      "Comment": "Partial containment. Nothing is rolled back; the alert reports from the ledger exactly which actions completed.",
      "Resource": "${AlertFunctionArn}",
      "Parameters": {
        "notifyKind": "CONTAINMENT_FAILED",
        "incidentId.$": "$.incidentId",
        "findingId.$": "$.findingId",
        "accountId.$": "$.accountId",
        "region.$": "$.region",
        "finding.$": "$.finding",
        "enrichment.$": "$.enrichment",
        "decision.$": "$.decision",
        "error.$": "$.error"
      },
      "ResultPath": "$.notification",
      "TimeoutSeconds": 30,
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "ContainmentIncomplete"
    },
    "NotifyVerifyFailed": {
      "Type": "Task",
      "Comment": "The finding was missing, archived, or did not match its identifiers. No action taken.",
      "Resource": "${AlertFunctionArn}",
      "Parameters": {
        "notifyKind": "VERIFY_FAILED",
        "incidentId.$": "$.incidentId",
        "findingId.$": "$.findingId",
        "accountId.$": "$.accountId",
        "region.$": "$.region",
        "error.$": "$.error"
      },
      "ResultPath": "$.notification",
      "TimeoutSeconds": 30,
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "NotVerified"
    },
    "NotifyPipelineError": {
      "Type": "Task",
      "Resource": "${AlertFunctionArn}",
      "Parameters": {
        "notifyKind": "PIPELINE_ERROR",
        "incidentId.$": "$.incidentId",
        "findingId.$": "$.findingId",
        "accountId.$": "$.accountId",
        "region.$": "$.region",
        "finding.$": "$.finding",
        "enrichment.$": "$.enrichment",
        "error.$": "$.error"
      },
      "ResultPath": "$.notification",
      "TimeoutSeconds": 30,
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "PipelineFailed"
    },
    "NotVerified": {
      "Type": "Fail",
      "Error": "FindingNotVerified",
      "Cause": "The finding could not be re-fetched, or was archived. A notification was sent."
    },
    "ContainmentIncomplete": {
      "Type": "Fail",
      "Error": "ContainmentIncomplete",
      "Cause": "Containment did not finish. Nothing was rolled back; see the incident record."
    },
    "PipelineFailed": {
      "Type": "Fail",
      "Error": "PipelineError",
      "Cause": "The pipeline failed before reaching a decision. A notification was sent."
    }
  }
}
